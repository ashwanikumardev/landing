<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= description %>">
    <meta name="keywords" content="<%= article.keyword %>">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/css/style.css">

    <!-- Open Graph -->
    <meta property="og:title" content="<%= article.metaTitle %>">
    <meta property="og:description" content="<%= article.metaDescription %>">
    <meta property="og:type" content="article">
    <meta property="og:url" content="<%= siteUrl %>/blog/<%= article.slug %>">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= article.metaTitle %>">
    <meta name="twitter:description" content="<%= article.metaDescription %>">
</head>

<body>
    <!-- Header Top -->
    <div class="header-top">
        <div class="container">
            <span>
                <%= new Date().toLocaleDateString('en-US', { weekday: 'long' , year: 'numeric' , month: 'long' ,
                    day: 'numeric' }) %>
            </span>
        </div>
    </div>

    <!-- Header Main -->
    <header class="header">
        <div class="header-main">
            <div class="container">
                <div class="header-content">
                    <a href="/" class="logo">Aug<span>Codex</span></a>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="nav">
            <div class="container">
                <ul class="nav-links">
                    <li><a href="/">Home</a></li>
                    <% const categories=['Technology', 'Health' , 'Finance' , 'Business' , 'Lifestyle' , 'Education'
                        , 'Travel' , 'Food' , 'Entertainment' ]; %>
                        <% categories.forEach(cat=> { %>
                            <li><a href="/category/<%= cat %>" class="<%= cat === article.category ? 'active' : '' %>">
                                    <%= cat %>
                                </a></li>
                            <% }); %>
                </ul>
            </div>
        </nav>
    </header>

    <!-- Article Content -->
    <article class="article-page">
        <div class="container">
            <!-- Breadcrumb -->
            <div class="breadcrumb">
                <a href="/">Home</a> /
                <a href="/category/<%= article.category %>">
                    <%= article.category %>
                </a> /
                <span>
                    <%= article.title %>
                </span>
            </div>

            <!-- Article Header -->
            <header class="article-header">
                <% if (article.category) { %>
                    <span class="article-category-badge">
                        <%= article.category %>
                    </span>
                    <% } %>
                        <h1 class="article-page-title">
                            <%= article.title %>
                        </h1>

                        <div class="article-page-meta">
                            <time datetime="<%= article.publishedAt %>">
                                <%= new Date(article.publishedAt).toLocaleDateString('en-US', { month: 'long' ,
                                    day: 'numeric' , year: 'numeric' }) %>
                            </time>
                            <span class="separator">•</span>
                            <span>
                                <%= article.views %> views
                            </span>
                        </div>
            </header>

            <!-- Article Body -->
            <div class="article-body">
                <%- article.contentHtml %>
            </div>

            <!-- FAQs -->
            <% if (article.faqs && article.faqs.length> 0) { %>
                <section class="article-faqs">
                    <h2>Frequently Asked Questions</h2>
                    <% article.faqs.forEach((faq, index)=> { %>
                        <div class="faq-item">
                            <h3>
                                <%= faq.question %>
                            </h3>
                            <p>
                                <%= faq.answer %>
                            </p>
                        </div>
                        <% }); %>
                </section>
                <% } %>
        </div>
    </article>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> AugCodex. All rights reserved.</p>
            <p class="footer-links">
                <a href="/sitemap.xml">Sitemap</a> |
                <a href="/robots.txt">Robots</a> |
                <a href="/health">Status</a>
            </p>
        </div>
    </footer>
</body>

</html>